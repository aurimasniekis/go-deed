  {
   "type": "timeseries",
   "title": "Requests by route",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 6
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route) (rate(deed_http_requests_total[$__rate_interval]))",
     "legendFormat": "{{route}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "5xx ratio",
   "id": 10,
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 8,
    "y": 6
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(deed_http_requests_total{code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(deed_http_requests_total[$__rate_interval])), 1e-9)",
     "legendFormat": "5xx",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {}
  },
