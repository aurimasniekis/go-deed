# Deed standalone deployment (systemd). Adapted from Porch deploy/systemd/porch.service (Apache-2.0).
# Install: deploy/systemd/README.md.
#
#   /usr/local/bin/deed          binary, root-owned 0755
#   /etc/deed/deed.yaml          configuration (secret-free), root:deed 0640
#   /etc/deed/kek                KEK, deed:deed 0400 (`deed keys init -out /etc/deed/kek`); never inside data_dir
#   /var/lib/deed                data dir, deed:deed 0700 (StateDirectory)
# Check the sandbox on the target host with: systemd-analyze security deed.service

[Unit]
Description=Deed infrastructure graph
Documentation=https://github.com/aurimasniekis/go-deed/tree/main/deploy/systemd
After=network-online.target
Wants=network-online.target
AssertPathExists=/etc/deed/kek
AssertPathExists=/etc/deed/deed.yaml

[Service]
Type=simple
User=deed
Group=deed
Environment=DEED_CONFIG=/etc/deed/deed.yaml
ExecStart=/usr/local/bin/deed serve
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30s
TimeoutStartSec=120s
LimitNOFILE=65536
UMask=0077
StateDirectory=deed
StateDirectoryMode=0700

# ---- Sandboxing -----------------------------------------------------------------------------------------------------
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/var/lib/deed
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @swap @reboot @raw-io @module @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM
DevicePolicy=closed
KeyringMode=private

[Install]
WantedBy=multi-user.target
